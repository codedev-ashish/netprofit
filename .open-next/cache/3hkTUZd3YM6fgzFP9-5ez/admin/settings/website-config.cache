"\"]\n6:I[74581,[],\"\"]\n:HL[\"/_next/static/css/3f0d8e470113b4d8.css\",\"style\"]\n3:T58c,\n            (function() {\n              const removeBis = (node) => {\n                if (!node) return;\n                if (node.removeAttribute && node.hasAttribute('bis_skin_checked')) {\n                  node.removeAttribute('bis_skin_checked');\n                }\n                if (node.querySelectorAll) {\n                  node.querySelectorAll('[bis_skin_checked]').forEach(el => el.removeAttribute('bis_skin_checked'));\n                }\n              };\n              const observer = new MutationObserver((mutations) => {\n                for (let i = 0; i < mutations.length; i++) {\n                  const m = mutations[i];\n                  if (m.type === 'attributes' && m.attributeName === 'bis_skin_checked') {\n                    removeBis(m.target);\n                  }\n                  if (m.addedNodes) {\n                    for (let j = 0; j < m.addedNodes.length; j++) {\n                      removeBis(m.addedNodes[j]);\n                    }\n                  }\n                }\n              });\n              observer.observe(document.documentElement, {\n                childList: true,\n                subtree: true,\n                attributes: true,\n                attributeFilter: ['bis_skin_checked']\n              });\n              document.addEventListener('DOMContentLoaded', () => {\n                removeBis(document.documentElement);\n              });\n            })();\n          0:{\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/3f0d8e470113b4d8.css\",\"precedence\":\"next\"}]],[\"$\",\"html\",null,{\"lang\":\"en\",\"className\":\"__variable_246ccd __variable_4c40f6\",\"suppressHydrationWarning\":true,\"children\":[[\"$\",\"head\",null,{\"children\":[\"$\",\"$L2\",null,{\"id\":\"remove-bis\",\"strategy\":\"beforeInteractive\",\"children\":\"$3\"}]}],[\"$\